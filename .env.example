# Local validator or Solana Devnet only. Do not use a mainnet endpoint.
VOUCHVAULT_CLUSTER=localnet
VOUCHVAULT_RPC_URL=http://127.0.0.1:8899
# Set to the configured Devnet test-USDC mint before application integration.
VOUCHVAULT_QUOTE_MINT=
# Frontend cluster defaults to devnet; set to localnet for a local validator.
NEXT_PUBLIC_VOUCHVAULT_CLUSTER=devnet
# Devnet deployer keypair path only; never put a key in an environment value.
# ANCHOR_WALLET=/absolute/path/outside/repository/devnet-deployer.json
