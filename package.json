{
  "name": "vouchvault",
  "version": "0.1.0",
  "private": true,
  "description": "VouchVault - Verifiable Growth Capital & Programmable Attention Treasuries on Solana",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "pnpm --filter @vouchvault/web dev",
    "dev:devnet": "NEXT_PUBLIC_VOUCHVAULT_CLUSTER=devnet pnpm --filter @vouchvault/web dev",
    "dev:localnet": "NEXT_PUBLIC_VOUCHVAULT_CLUSTER=localnet pnpm --filter @vouchvault/web dev",
    "build": "pnpm --filter @vouchvault/chain-config build && pnpm --filter @vouchvault/web build",
    "test": "pnpm --filter @vouchvault/chain-config test && pnpm --filter @vouchvault/web test",
    "typecheck": "pnpm --filter @vouchvault/chain-config typecheck && pnpm --filter @vouchvault/web typecheck",
    "lint": "pnpm --filter @vouchvault/chain-config lint && pnpm --filter @vouchvault/web lint",
    "web:test": "pnpm --filter @vouchvault/web test",
    "web:typecheck": "pnpm --filter @vouchvault/web typecheck",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "verify:env": "node scripts/verify-env.mjs",
    "anchor:build": "anchor build --tools-version v1.57",
    "rust:fmt:check": "cargo fmt --all -- --check",
    "rust:lint": "cargo clippy --workspace --all-targets --locked",
    "test:validator": "node scripts/test-local-validator.mjs",
    "typecheck:tests": "tsc -p tsconfig.json",
    "verify": "./toolchain/run-verification.sh",
    "idl:sync": "cp target/idl/vouchvault_token.json packages/web/src/generated/vouchvault_token.json && cp target/types/vouchvault_token.ts packages/web/src/generated/vouchvault_token.ts",
    "idl:check": "node scripts/check-web-idl.mjs",
    "devnet:preflight": "node scripts/devnet-preflight.mjs",
    "devnet:deploy": "bash scripts/deploy-devnet.sh"
  },
  "devDependencies": {
    "@anchor-lang/core": "1.2.2",
    "@eslint/js": "^9.39.1",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.99.0",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "24.10.0",
    "chai": "5.2.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "mocha": "11.7.4",
    "prettier": "^3.6.2",
    "ts-mocha": "10.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.13"
  }
}
